  "about": {
    "title": "About",
    "greeting": "Hi, I'm Peter",
    "professional": {
      "intro": "I'm a software developer with 10+ years of experience specializing in React, TypeScript, and Next.js development. Based in Slovakia (Central European Time), I work with international teams building complex web applications.",
      "experience": "I've been a core developer on analytics dashboards and data visualization tools, currently working on enterprise applications with extensive filtering systems and large-scale data handling.",
      "whatIDoTitle": "What I do",
      "whatIDo1": "Build React/Next.js applications (dashboards, SaaS platforms, data-heavy interfaces)",
      "whatIDo2": "SEO & performance optimization",
      "whatIDo3": "Mobile responsiveness & accessibility improvements",
      "approachTitle": "My approach",
      "approach": "I leverage AI tools to accelerate development while maintaining security best practices. I work with modern tooling (Next.js LTS, TypeScript, Tailwind, TanStack Query, Git workflows) and can scale projects with trusted development partners when needed.",
      "languagesTitle": "Languages",
      "languages": "English (fluent), Spanish (intermediate), Slovak (native)"
    },
    "knowMeBetter": "Want to know me better?",
    "personal": {
      "hobbies": "When I'm not coding, you'll find me climbing, hiking, skiing, or traveling with my camera. I've explored 40+ countries and regularly give talks at outdoor and travel festivals.",
      "home": "At home, I usually play guitar, or read",
      "toRemove": "and spend time with Kocurenko (my cat has his own page).",
      "prints": "I also sell travel photography prints from my adventures around the world."
    },
